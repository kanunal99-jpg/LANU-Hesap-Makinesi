<?xml version="1.0" encoding="utf-8"?>
<!-- Exclude private app data from Android 12+ cloud backup and device transfer.
     Keep this even with allowBackup=false: some devices treat device transfer separately. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
    </device-transfer>
</data-extraction-rules>
